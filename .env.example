# This is an example file for environment variables.
# Copy this file to .env and fill in your actual values.
# The .env file should be added to .gitignore and not committed to version control.

# Your official PUBG API Key
# You can obtain one from https://developer.pubg.com/
PUBG_API_KEY="YOUR_PUBG_API_KEY_HERE"

# Optional: Set the log level for Uvicorn (e.g., info, debug, warning, error, critical)
# LOG_LEVEL="info"
# Uvicorn host and port can also be environment variables if needed by your run script/Dockerfile CMD
# HOST="0.0.0.0"
# PORT="8000"
